---
import "@/styles/global.css";
import background from "@/assets/background.svg";
import "@fontsource-variable/inter";
---

<!doctype html>
<html lang="en">
	<head>
		<title>unixdt – Timestamp Converter</title>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Convert Unix timestamps to/from readable dates"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
	</head>
	<body>
		<main class="container relative mx-auto lg:px-16">
			<img
				class="fixed top-0 left-0 w-full h-full -z-10 blur-[128px]"
				src={background.src}
				alt=""
				fetchpriority="high"
			/>
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
